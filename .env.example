# Copy this file to `.env` and paste your Anthropic API key over the
# placeholder. The app writes the key back to the same file when you
# submit one through the in-page keybar, so if you paste it there
# instead you can leave this file alone.
ANTHROPIC_API_KEY=PASTE_KEY_HERE

# Optional: pin a specific model. Leave commented out and the app asks
# the API which Sonnet variant your key can see, and caches that choice.
# ANTHROPIC_MODEL=claude-sonnet-5
